# Neon Postgres (pulled by `neon deploy` / `neon env pull`)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
NEON_BRANCH=production

# Auth.js
AUTH_SECRET="generate-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Optional Google auth (also set NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
